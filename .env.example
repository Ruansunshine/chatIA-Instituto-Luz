# ---- Node (backend-node) ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# ---- MySQL ----
MYSQL_DATABASE=chat_ia
MYSQL_USER=chat_ia
MYSQL_PASSWORD=chat_ia
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3310
DATABASE_URL=mysql://chat_ia:chat_ia@mysql:3306/chat_ia

# ---- Flyway ----
FLYWAY_URL=jdbc:mysql://mysql:3306/chat_ia?allowPublicKeyRetrieval=true&useSSL=false
FLYWAY_USER=chat_ia
FLYWAY_PASSWORD=chat_ia

# ---- Ollama ----
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://ollama:11434

# ---- Serviço Python (RAG) ----
PYTHON_SERVICE_URL=http://backend-python:8001

# ---- ChromaDB ----
CHROMA_URL=http://chroma:8000
CHROMA_HOST=chroma
CHROMA_PORT=8000
